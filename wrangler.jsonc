
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nova-ai",
  "main": "src/index.js",
  "compatibility_date": "2026-11-10",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./frontend",
    "binding": "ASSETS",
    "run_worker_first": [
      "/chat",
      "/history",
      "/health"
    ]
  }
}
