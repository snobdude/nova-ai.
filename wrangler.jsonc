
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nova-ai",
  "main": "src/index.js",
  "compatibility_date": "2026-11-10",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./frontend",
    "binding": "ASSETS",
    "run_worker_first": [
      "/chat",
      "/history",
      "/health",
      "/register",
      "/login",
      "/logout",
      "/me"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nova-memory",
      "database_id": "aba5daaa-8b72-48b7-8b52-72d9ad3c9cd4"
    }
  ]
}
